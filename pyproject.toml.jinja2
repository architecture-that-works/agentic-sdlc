[project]
name = "{{ project_name }}"
version = "0.1.0"
requires-python = "==3.14.*"
dependencies = [
    "anthropic>=0.40.0",
    "pydantic-settings>=2.0.0",
]

[project.scripts]
commit-msg = "src.tools.commit:main"

[dependency-groups]
dev = [
    "pytest>=8.0.0",
    "pyright>=1.1.0",
    "ruff>=0.9.0",
    "pytest-cov>=7.1.0",
    "pip-audit>=2.10.0",
    "copier>=9.0.0",
    "pre-commit>=4.0.0",
    "hypothesis>=6.0.0",
]

[tool.pytest.ini_options]
# Evals call a model: opt in with `uv run pytest -m eval` (a later -m overrides this one).
addopts = ["-m", "not eval"]
markers = [
    "eval: runs one stage's instructions on a stored case and checks the outcome in code; calls Claude (run with -m eval)",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src"]
